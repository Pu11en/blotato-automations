# Copy to .env in your workspace directory. Never commit the real key.
# An exported BLOTATO_API_KEY in your shell takes precedence over this file.
BLOTATO_API_KEY=

# Optional: where relative asset paths and outputs/ resolve against.
# Defaults to the directory you run `blotato` from.
# BLOTATO_WORKSPACE=

# Optional, only for the Pinterest research workflow.
# PINTEREST_ACCESS_TOKEN=
# PINTEREST_OPENCLI_BIN=
